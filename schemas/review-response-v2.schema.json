{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:episteme:review-response:v2",
  "title": "Assigned local reviewer response v2 (veto reconsideration)",
  "$comment": "Transport shape only; required exactly under policy veto_reconsideration_v1 (ADR 0018). review.submit rechecks that withdrawals list exactly the reviewer's open opinions in the claim family, that resolutions name only the reviewer's own obligations unresolved for this claim, and the kind-specific resolution conditions. Actor identity and read isolation are not enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assignment", "bundle", "claim", "basis_hash", "reviewer_actor", "verdict", "rationale", "findings", "link_assessments", "withdrawals", "resolutions"],
  "properties": {
    "schema_version": {"const": 2},
    "assignment": {"$ref": "#/$defs/text"},
    "bundle": {"$ref": "#/$defs/sha256"},
    "claim": {"$ref": "#/$defs/text"},
    "basis_hash": {"$ref": "#/$defs/sha256"},
    "reviewer_actor": {"$ref": "#/$defs/text"},
    "verdict": {"enum": ["approve", "request_changes", "reject"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S"},
    "findings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}},
    "link_assessments": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/link_assessment"}}
      ]
    },
    "withdrawals": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/withdrawal"}},
    "resolutions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/resolution"}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "approve"}}},
     "then": {"properties": {"findings": {"maxItems": 0}}},
     "else": {"properties": {"findings": {"minItems": 1},
                             "withdrawals": {"maxItems": 0},
                             "resolutions": {"maxItems": 0}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "action", "closure_criterion", "evidence_refs"],
      "properties": {
        "kind": {"enum": ["discriminating_experiment", "independent_reanalysis", "narrow_claim", "request_data", "stop_inconclusive"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
        "closure_criterion": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                          "items": {"$ref": "#/$defs/text"}}
      }
    },
    "link_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["judgment", "disposition", "rationale", "evidence"],
      "properties": {
        "judgment": {"enum": ["accepted", "rejected", "unresolved"]},
        "disposition": {"enum": ["compatible_as_written", "requires_claim_revision", "needs_evidence"]},
        "rationale": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"$ref": "#/$defs/text"}}
      }
    },
    "bounded": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "withdrawal": {
      "type": "object", "additionalProperties": false,
      "required": ["opinion", "rationale"],
      "properties": {
        "opinion": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/bounded"}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation", "rationale", "evidence_refs"],
      "properties": {
        "obligation": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/bounded"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                          "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
