{
  "$comment": "Frozen form of a read-only capture of a declared local source. Inventory paths are sorted, unique, relative POSIX paths; the kernel stores the bytes. Hashes identify captured bytes, not historical time or completeness of the source.",
  "$id": "urn:epistemeos:capture-bundle:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "type": "object"
    },
    "inventory": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 67108864,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "pack_id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "pack_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "local_directory"
          ]
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "source",
    "inventory",
    "audit"
  ],
  "title": "EpistemeOS DomainPack capture bundle v1",
  "type": "object"
}
