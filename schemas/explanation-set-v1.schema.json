{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdamCage/EpistemeOS/schemas/explanation-set-v1.schema.json",
  "title": "ExplanationSet v1 event payload",
  "description": "Immutable hypothesis pool bound to a research question revision. Hash equality, exact scope, lineage heads and exact removed-hypothesis exclusion keys require runtime validation. The comparison plan does not establish scientific discriminability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "question", "question_hash", "hypotheses", "hypothesis_hashes", "comparison_plan", "parent", "parent_hash", "revision_reason", "excluded_reasons"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "study_id": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "question_hash": {"$ref": "#/$defs/digest"},
    "hypotheses": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "hypothesis_hashes": {
      "type": "object", "minProperties": 2,
      "propertyNames": {"$ref": "#/$defs/text"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "comparison_plan": {"$ref": "#/$defs/text"},
    "parent": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "parent_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "revision_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "excluded_reasons": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/text"},
      "additionalProperties": {"$ref": "#/$defs/text"}
    }
  },
  "allOf": [{
    "if": {"properties": {"parent": {"type": "null"}}},
    "then": {"properties": {"parent_hash": {"type": "null"}, "revision_reason": {"type": "null"}, "excluded_reasons": {"maxProperties": 0}}},
    "else": {"properties": {"parent_hash": {"$ref": "#/$defs/digest"}, "revision_reason": {"$ref": "#/$defs/text"}}}
  }],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
